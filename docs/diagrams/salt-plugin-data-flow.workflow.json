      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "spine-rows",
      "from": "element_data",
      "to": "spine",
      "label": "ESO rows",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "spine-execution",
      "from": "spine",
      "to": "field_exec",
      "label": "Stage 4+ math",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "detail-columns",
      "from": "normalize",
      "to": "detail_fallback",
      "label": "detail columns",
      "variant": "dashed",
      "role": "branch",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "drop"
    },
    {
      "id": "detail-backup",
      "from": "detail_fallback",
      "to": "field_exec",
      "label": "spine keys missing",
      "variant": "dashed",
      "role": "error",
      "labelDx": -62
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Panel Source to Card",
      "items": [
        "source_commit_card drives the Sales Forecast family",
        "source_budget sums Total Company Target rows",
        "source_drill_forecast_attainment_payload feeds Pacing",
        "source_detail only supplies the greeting and data.d"
      ]
    },
    {
      "dot": "amber",
      "title": "Resolution Rules",
      "items": [
        "Element IDs come from the Sigma URL, never hardcoded",
        "COLUMN_ALIASES map cc_, fa_, and eso_ prefixes to fields",
        "ESO columns resolve by alias, not per-field panel entries",
        "companyTotalsStub.js stands in when no Sigma host exists"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why It Matters",
      "items": [
        "Every card traces back to one panel binding",
        "Missing bindings degrade instead of crashing",
        "Panel entries cost URL budget, so unused ones get cut",
        "Stage 4+ math moved from company data to the ESO spine"
      ]
    }
  ]
}
