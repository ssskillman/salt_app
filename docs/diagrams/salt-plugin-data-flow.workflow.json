    {
      "id": "spine",
      "lane": "derive",
      "col": 2,
      "type": "database",
      "label": "ESO Spine",
      "sublabel": "opportunity grain",
      "width": 100
    },
    {
      "id": "transforms",
      "lane": "derive",
